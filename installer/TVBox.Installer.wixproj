<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <Platform>x64</Platform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.3</ProductVersion>
    <ProductCode Condition="'$(ProductCode)' == ''">B7D7FA95-EF8D-55E1-A1C2-FF84B37FD5CB</ProductCode>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\TVBox-x64-1.0.3</PublishDir>
    <Cultures>zh-CN</Cultures>
    <OutputName>TVBox-Setup-x64-$(ProductVersion)</OutputName>
    <DefineConstants>$(DefineConstants);ProductVersion=$(ProductVersion);ProductCode=$(ProductCode);PublishDir=$(PublishDir)</DefineConstants>
    <SuppressPdbOutput>true</SuppressPdbOutput>
    <!-- Some Windows App SDK binaries expose nonstandard PE language metadata. -->
    <SuppressIces>$(SuppressIces);ICE03</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <BindPath Include="$(PublishDir)" BindName="Publish" />
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
  </ItemGroup>
</Project>
