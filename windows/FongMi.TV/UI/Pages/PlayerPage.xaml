<Page
    x:Class="FongMi.TV.UI.Pages.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FongMi.TV.UI.Controls"
    xmlns:fl="using:FlyleafLib.Controls.WinUI"
    IsTabStop="True"
    RequestedTheme="Dark"
    Background="Transparent">

    <Page.Resources>
        <!-- 控制层淡入淡出 -->
        <Storyboard x:Name="FadeInControls">
            <DoubleAnimation Storyboard.TargetName="ControlLayer" Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.15"/>
        </Storyboard>
        <Storyboard x:Name="FadeOutControls">
            <DoubleAnimation Storyboard.TargetName="ControlLayer" Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.35"/>
        </Storyboard>
        <Style x:Key="PlayerIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="CompactPlayerIconButtonStyle" TargetType="Button" BasedOn="{StaticResource PlayerIconButtonStyle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
        </Style>
        <Style x:Key="CompactPlayerMenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="44"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- The ProgressBar below owns the unplayed/buffered track.  Keep Slider's
             remaining track transparent in every pointer state so hover cannot
             paint a second gray line over the buffered progress. -->
        <SolidColorBrush x:Key="SliderTrackFill" Color="Transparent"/>
        <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="Transparent"/>
        <SolidColorBrush x:Key="SliderTrackFillPressed" Color="Transparent"/>
        <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="Transparent"/>
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FF78D7E6"/>
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FF78D7E6"/>
        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FF78D7E6"/>
        <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="#9978D7E6"/>
        <SolidColorBrush x:Key="SliderThumbBackground" Color="#FF78D7E6"/>
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FF8DE4F0"/>
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FF65C4D4"/>
        <x:Double x:Key="SliderTrackThemeHeight">3</x:Double>
    </Page.Resources>

    <Grid x:Name="PageRoot" Padding="16" Background="Transparent">
        <Border x:Name="PlayerSurface"
                Background="Black"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="8">
    <!-- 右侧滑出选集面板 -->
    <SplitView x:Name="EpisodeSplit"
               DisplayMode="Overlay"
               PanePlacement="Right"
               OpenPaneLength="360"
               PaneBackground="#F51A1A1A"
               Background="Black">
        <SplitView.Pane>
            <Grid Padding="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,4,0,8">
                    <TextBlock Text="选集" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="&#xE711;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                            Click="OnCloseEpisodePane" ToolTipService.ToolTip="关闭"/>
                </Grid>
                <TextBlock x:Name="PaneInfoText" Grid.Row="1" FontSize="12" Margin="0,0,0,8"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <ListView x:Name="EpisodeList" Grid.Row="2" SelectionMode="Single"
                          IsItemClickEnabled="True" ItemClick="OnEpisodeItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,6"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </SplitView.Pane>

        <Grid x:Name="PlayerArea" Background="Black" PointerMoved="OnPointerMoved">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="PlayerWidthStates">
                    <VisualState x:Name="CompactPlayer">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ScaleButton.Visibility" Value="Collapsed"/>
                            <Setter Target="FlagButton.Visibility" Value="Collapsed"/>
                            <Setter Target="DanmakuMenuButton.Visibility" Value="Collapsed"/>
                             <Setter Target="SubButton.Visibility" Value="Collapsed"/>
                             <Setter Target="GearButton.Visibility" Value="Collapsed"/>
                             <Setter Target="PipButton.Visibility" Value="Collapsed"/>
                             <Setter Target="EpisodeButton.Visibility" Value="Collapsed"/>
                             <Setter Target="CompactMoreButton.Visibility" Value="Visible"/>
                             <Setter Target="PrevEpisodeButton.Visibility" Value="Collapsed"/>
                             <Setter Target="NextEpisodeButton.Visibility" Value="Collapsed"/>
                             <Setter Target="TitleText.MaxWidth" Value="240"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="MediumPlayer">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="900"/></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ScaleButton.Visibility" Value="Visible"/>
                            <Setter Target="FlagButton.Visibility" Value="Visible"/>
                            <Setter Target="DanmakuMenuButton.Visibility" Value="Collapsed"/>
                            <Setter Target="SubButton.Visibility" Value="Collapsed"/>
                            <Setter Target="GearButton.Visibility" Value="Visible"/>
                            <Setter Target="PipButton.Visibility" Value="Visible"/>
                            <Setter Target="EpisodeButton.Visibility" Value="Collapsed"/>
                            <Setter Target="CompactMoreButton.Visibility" Value="Visible"/>
                            <Setter Target="TitleText.MaxWidth" Value="360"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="WidePlayer">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1280"/></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ScaleButton.Visibility" Value="Visible"/>
                            <Setter Target="FlagButton.Visibility" Value="Visible"/>
                            <Setter Target="DanmakuMenuButton.Visibility" Value="Visible"/>
                            <Setter Target="SubButton.Visibility" Value="Visible"/>
                            <Setter Target="GearButton.Visibility" Value="Visible"/>
                            <Setter Target="PipButton.Visibility" Value="Visible"/>
                            <Setter Target="EpisodeButton.Visibility" Value="Visible"/>
                            <Setter Target="CompactMoreButton.Visibility" Value="Collapsed"/>
                            <Setter Target="TitleText.MaxWidth" Value="520"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- 视频层 -->
            <fl:FlyleafHost x:Name="VideoHost" KeyBindings="False" Background="Black"/>

            <!-- 弹幕层（DanmakuView 纯 C# 控件，代码后置注入） -->
            <Grid x:Name="DanmakuLayer" IsHitTestVisible="False"/>

            <!-- 交互层：FlyleafHost 可能吞掉指针事件，用透明层接收单击/双击 -->
            <Grid x:Name="InteractLayer" Background="Transparent"
                  Tapped="OnPlayerTapped" DoubleTapped="OnPlayerDoubleTapped"/>

            <!-- 加载层：海报铺底 + 深色遮罩 + 状态文字 -->
            <Grid x:Name="LoadingOverlay" Visibility="Collapsed">
                <controls:PosterImage x:Name="LoadingPoster" Opacity="0.3"/>
                <Border Background="#A6000000"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                    <ProgressRing IsActive="True" Width="56" Height="56"/>
                    <TextBlock x:Name="StatusText" Text="解析中…" FontSize="14" HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <!-- 控制层（3 秒无操作淡出） -->
            <Grid x:Name="ControlLayer">

                <!-- 顶部条：返回 + 片名/集名 -->
                <Grid x:Name="TopBar" VerticalAlignment="Top" Padding="20,14,20,28">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#C0000000" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Background="Transparent" BorderThickness="0" Padding="8"
                            Click="OnBack" ToolTipService.ToolTip="返回 (Esc)">
                        <FontIcon Glyph="&#xE72B;" FontSize="16"/>
                    </Button>
                    <Border x:Name="CompactDragRegion"
                            Grid.Column="1"
                            Background="Transparent"
                            Visibility="Collapsed"
                            PointerPressed="OnCompactDragPressed"/>
                    <StackPanel x:Name="TitlePanel" Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                VerticalAlignment="Center" Margin="12,0">
                        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold"
                                   MaxWidth="520" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock x:Name="EpNameText" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   MaxWidth="240" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <!-- 底部条：进度 + 控制按钮 -->
                <Grid x:Name="BottomBar" VerticalAlignment="Bottom" Padding="20,52,20,14">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#E6000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Border VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch"
                            MaxWidth="1480"
                            Padding="12,8,12,10"
                            Background="#DC111111"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1"
                            CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                    <!-- 进度：缓冲条铺底 + Slider（拖动 Seek，拇指浮窗显示时间） -->
                    <Grid Grid.Row="0" Height="30">
                        <ProgressBar x:Name="BufferBar" VerticalAlignment="Center" Height="3" Margin="9,0"
                                     Minimum="0" Maximum="1" IsHitTestVisible="False"
                                     Foreground="#80FFFFFF" Background="#33FFFFFF"/>
                        <Slider x:Name="SeekSlider" VerticalAlignment="Center" Padding="9,0"
                                Background="Transparent" Foreground="#FF78D7E6"
                                Minimum="0" Maximum="1" StepFrequency="1000" IsThumbToolTipEnabled="True"
                                ValueChanged="OnSeekChanged"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- 左簇：播放控制 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Left">
                            <Button x:Name="PrevEpisodeButton" Style="{StaticResource PlayerIconButtonStyle}"
                                    Click="OnPrevEpisode" ToolTipService.ToolTip="上一集 ([)">
                                <FontIcon Glyph="&#xE892;" FontSize="14"/>
                            </Button>
                            <Button Style="{StaticResource PlayerIconButtonStyle}"
                                    Click="OnPlayPause" ToolTipService.ToolTip="播放/暂停 (Space)"
                                    AutomationProperties.Name="播放或暂停">
                                <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="17"/>
                            </Button>
                            <Button x:Name="NextEpisodeButton" Style="{StaticResource PlayerIconButtonStyle}"
                                    Click="OnNextEpisode" ToolTipService.ToolTip="下一集 (])">
                                <FontIcon Glyph="&#xE893;" FontSize="14"/>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="TimeText" Grid.Column="1" Text="00:00 / 00:00" FontSize="13"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <!-- 右簇：倍速/缩放/线路/选集/弹幕/字幕/设置/画中画/全屏 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                            <Button x:Name="SpeedButton" Background="Transparent"
                                    BorderThickness="0" Padding="8,6" ToolTipService.ToolTip="倍速">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock x:Name="SpeedText" Text="1x"/>
                                    <FontIcon x:Name="SpeedChevron" Glyph="&#xE70D;" FontSize="9"/>
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout x:Name="SpeedMenu" Opened="OnSpeedMenuOpened" Closed="OnSpeedMenuClosed">
                                        <RadioMenuFlyoutItem Text="1x" Tag="1" GroupName="speed" IsChecked="True" Click="OnSpeedItem"/>
                                        <RadioMenuFlyoutItem Text="1.25x" Tag="1.25" GroupName="speed" Click="OnSpeedItem"/>
                                        <RadioMenuFlyoutItem Text="1.5x" Tag="1.5" GroupName="speed" Click="OnSpeedItem"/>
                                        <RadioMenuFlyoutItem Text="1.75x" Tag="1.75" GroupName="speed" Click="OnSpeedItem"/>
                                        <RadioMenuFlyoutItem Text="2x" Tag="2" GroupName="speed" Click="OnSpeedItem"/>
                                        <RadioMenuFlyoutItem Text="2.5x" Tag="2.5" GroupName="speed" Click="OnSpeedItem"/>
                                        <RadioMenuFlyoutItem Text="3x" Tag="3" GroupName="speed" Click="OnSpeedItem"/>
                                        <RadioMenuFlyoutItem Text="4x" Tag="4" GroupName="speed" Click="OnSpeedItem"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>

                            <Button x:Name="ScaleButton" Background="Transparent"
                                    BorderThickness="0" Padding="8,6" ToolTipService.ToolTip="画面缩放">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock x:Name="ScaleText" Text="原始"/>
                                    <FontIcon x:Name="ScaleChevron" Glyph="&#xE70D;" FontSize="9"/>
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout x:Name="ScaleMenu" Opened="OnScaleMenuOpened" Closed="OnScaleMenuClosed">
                                        <RadioMenuFlyoutItem Text="原始" Tag="0" GroupName="scale" IsChecked="True" Click="OnScaleItem"/>
                                        <RadioMenuFlyoutItem Text="拉伸" Tag="1" GroupName="scale" Click="OnScaleItem"/>
                                        <RadioMenuFlyoutItem Text="16:9" Tag="2" GroupName="scale" Click="OnScaleItem"/>
                                        <RadioMenuFlyoutItem Text="4:3" Tag="3" GroupName="scale" Click="OnScaleItem"/>
                                        <RadioMenuFlyoutItem Text="填充" Tag="4" GroupName="scale" Click="OnScaleItem"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>

                            <Button x:Name="FlagButton" Background="Transparent"
                                    BorderThickness="0" Padding="8,6" ToolTipService.ToolTip="切换线路">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock x:Name="FlagText" Text="线路" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                                    <FontIcon x:Name="FlagChevron" Glyph="&#xE70D;" FontSize="9"/>
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout x:Name="FlagMenu" Opened="OnFlagMenuOpened" Closed="OnFlagMenuClosed"/>
                                </Button.Flyout>
                            </Button>

                            <Button x:Name="EpisodeButton" Style="{StaticResource PlayerIconButtonStyle}"
                                    Click="OnOpenEpisodePane" ToolTipService.ToolTip="选集">
                                <FontIcon Glyph="&#xE8FD;" FontSize="15"/>
                            </Button>

                            <DropDownButton x:Name="CompactMoreButton" Visibility="Collapsed"
                                            Width="36" Height="36" Padding="0"
                                            Background="Transparent" BorderThickness="0"
                                            ToolTipService.ToolTip="更多">
                                <FontIcon Glyph="&#xE712;" FontSize="15"/>
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="CompactMoreMenu">
                                        <MenuFlyoutItem Text="选集" Click="OnOpenEpisodePane"/>
                                        <MenuFlyoutSeparator/>
                                        <MenuFlyoutItem Text="加载本地字幕…" Click="OnPickLocalSubtitle"/>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>

                            <Button x:Name="DanmakuButton" Style="{StaticResource PlayerIconButtonStyle}"
                                    Click="OnDanmakuToggle" ToolTipService.ToolTip="关闭弹幕 (D)">
                                <Grid Width="18" Height="18">
                                    <Grid x:Name="DanmakuOnIcon">
                                        <Path Data="M2.5,3.5 L15.5,3.5 L15.5,12.5 L9,12.5 L5.5,15.5 L5.5,12.5 L2.5,12.5 Z"
                                              Stroke="White" StrokeThickness="1.4" StrokeLineJoin="Round"/>
                                        <Path Data="M5,7 L13,7 M5,9.75 L10.5,9.75"
                                              Stroke="White" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Grid>
                                    <Grid x:Name="DanmakuOffIcon" Visibility="Collapsed">
                                        <Path Data="M2.5,3.5 L15.5,3.5 L15.5,12.5 L9,12.5 L5.5,15.5 L5.5,12.5 L2.5,12.5 Z"
                                              Stroke="White" StrokeThickness="1.4" StrokeLineJoin="Round"/>
                                        <Path Data="M3,2.5 L15,15.5" Stroke="White" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Grid>
                                </Grid>
                            </Button>

                            <Button x:Name="DanmakuMenuButton" Background="Transparent" BorderThickness="0"
                                    Padding="8,6" ToolTipService.ToolTip="弹幕源">
                                <FontIcon Glyph="&#xE70F;" FontSize="13"/>
                                <Button.Flyout>
                                    <Flyout x:Name="DanmakuFlyout" Opening="OnDanmakuFlyoutOpening">
                                        <StackPanel Width="300" Spacing="8">
                                            <TextBlock Text="弹幕源" FontWeight="SemiBold"/>
                                            <ListView x:Name="DanmakuList" MaxHeight="180" SelectionMode="None"
                                                      IsItemClickEnabled="True" ItemClick="OnDanmakuSourceClick">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                            <TextBlock x:Name="DanmakuEmptyText" Text="本片无内置弹幕源" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBox x:Name="DanmakuUrlBox" PlaceholderText="输入弹幕地址（XML/JSON）"/>
                                            <Button Content="加载" HorizontalAlignment="Right" Click="OnDanmakuUrlLoad"/>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <Button x:Name="SubButton" Width="38" Height="36" Background="Transparent"
                                    BorderThickness="0" Padding="0" IsEnabled="True"
                                    ToolTipService.ToolTip="字幕">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Grid Width="17" Height="17" IsHitTestVisible="False">
                                        <Path Data="M2,3.25 H15 A1,1 0 0 1 16,4.25 V12.75 A1,1 0 0 1 15,13.75 H2 A1,1 0 0 1 1,12.75 V4.25 A1,1 0 0 1 2,3.25 Z"
                                              Stroke="White" StrokeThickness="1.3" StrokeLineJoin="Round"/>
                                        <Path Data="M7.25,6.25 H5.5 A1.25,1.25 0 0 0 4.25,7.5 V9.5 A1.25,1.25 0 0 0 5.5,10.75 H7.25 M12.75,6.25 H11 A1.25,1.25 0 0 0 9.75,7.5 V9.5 A1.25,1.25 0 0 0 11,10.75 H12.75"
                                              Stroke="White" StrokeThickness="1.3" StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Grid>
                                    <FontIcon x:Name="SubChevron" Glyph="&#xE70D;" FontSize="8"/>
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout x:Name="SubMenu" Opened="OnSubMenuOpened" Closed="OnSubMenuClosed">
                                        <MenuFlyoutItem Text="加载本地字幕…" Click="OnPickLocalSubtitle"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>

                            <Button x:Name="GearButton" Background="Transparent" BorderThickness="0" Padding="8,6"
                                    ToolTipService.ToolTip="播放设置（跳片头尾）">
                                <FontIcon Glyph="&#xE713;" FontSize="15"/>
                                <Button.Flyout>
                                    <Flyout x:Name="GearFlyout" Opening="OnGearOpening">
                                        <StackPanel Width="260" Spacing="10">
                                            <TextBlock Text="跳过片头片尾" FontWeight="SemiBold"/>
                                            <ToggleSwitch x:Name="SkipToggle" Header="启用自动跳过" Toggled="OnSkipToggled"/>
                                            <NumberBox x:Name="OpeningBox" Header="片头（秒）" Minimum="0" Maximum="3600"
                                                       SpinButtonPlacementMode="Compact" ValueChanged="OnOpeningChanged"/>
                                            <NumberBox x:Name="EndingBox" Header="片尾（秒）" Minimum="0" Maximum="3600"
                                                       SpinButtonPlacementMode="Compact" ValueChanged="OnEndingChanged"/>
                                            <TextBlock Text="按当前影片记忆，随历史记录保存。" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <Button x:Name="PipButton" Style="{StaticResource PlayerIconButtonStyle}"
                                    Click="OnPip" ToolTipService.ToolTip="小窗模式"
                                    AutomationProperties.Name="开启小窗模式">
                                <Grid Width="18" Height="18">
                                    <Grid x:Name="PipEnterIcon">
                                        <Path Data="M8,15.25 H2.75 A1.25,1.25 0 0 1 1.5,14 V4 A1.25,1.25 0 0 1 2.75,2.75 H15.25 A1.25,1.25 0 0 1 16.5,4 V8.5 M10,9.75 H15.25 A1.25,1.25 0 0 1 16.5,11 V14 A1.25,1.25 0 0 1 15.25,15.25 H10 A1.25,1.25 0 0 1 8.75,14 V11 A1.25,1.25 0 0 1 10,9.75 Z"
                                              Stroke="White" StrokeThickness="1.3" StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Path Data="M4.25,5.25 L8.5,9.5 M5.5,9.5 H8.5 V6.5"
                                              Stroke="White" StrokeThickness="1.3" StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Grid>
                                    <Grid x:Name="PipExitIcon" Visibility="Collapsed">
                                        <Path Data="M8,15.25 H2.75 A1.25,1.25 0 0 1 1.5,14 V4 A1.25,1.25 0 0 1 2.75,2.75 H15.25 A1.25,1.25 0 0 1 16.5,4 V8.5 M10,9.75 H15.25 A1.25,1.25 0 0 1 16.5,11 V14 A1.25,1.25 0 0 1 15.25,15.25 H10 A1.25,1.25 0 0 1 8.75,14 V11 A1.25,1.25 0 0 1 10,9.75 Z"
                                              Stroke="White" StrokeThickness="1.3" StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Path Data="M8.5,9.5 L4.25,5.25 M4.25,8.25 V5.25 H7.25"
                                              Stroke="White" StrokeThickness="1.3" StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Grid>
                                </Grid>
                            </Button>

                            <Button x:Name="FullButton" Background="Transparent" BorderThickness="0" Padding="8,6"
                                    Click="OnFullscreen" ToolTipService.ToolTip="全屏 (F)">
                                <FontIcon x:Name="FullIcon" Glyph="&#xE740;" FontSize="15"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    </Grid>
                    </Border>
                </Grid>

                <!-- 小窗专用控制条：保留进度、时间、倍速和核心播放操作。 -->
                <Grid x:Name="CompactBottomBar" Visibility="Collapsed"
                      VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="8,0,8,8"
                      SizeChanged="OnCompactBottomBarSizeChanged">
                    <Border Padding="8,5,8,7" Background="#E6111111" BorderBrush="#33FFFFFF"
                            BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Height="30">
                                <ProgressBar x:Name="CompactBufferBar" VerticalAlignment="Center" Height="3" Margin="9,0"
                                             Minimum="0" Maximum="1" IsHitTestVisible="False"
                                             Foreground="#80FFFFFF" Background="#33FFFFFF"/>
                                <Slider x:Name="CompactSeekSlider" VerticalAlignment="Center" Height="30" Padding="9,0"
                                        Background="Transparent" Foreground="#FF78D7E6"
                                        Minimum="0" Maximum="1" StepFrequency="1000"
                                        IsThumbToolTipEnabled="True" ValueChanged="OnSeekChanged"/>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                                    <Button x:Name="CompactPrevEpisodeButton" Style="{StaticResource CompactPlayerIconButtonStyle}" Click="OnPrevEpisode"
                                            ToolTipService.ToolTip="上一集">
                                        <FontIcon Glyph="&#xE892;" FontSize="13"/>
                                    </Button>
                                    <Button Style="{StaticResource CompactPlayerIconButtonStyle}" Click="OnPlayPause"
                                            ToolTipService.ToolTip="播放/暂停">
                                        <FontIcon x:Name="CompactPlayPauseIcon" Glyph="&#xE768;" FontSize="16"/>
                                    </Button>
                                    <Button x:Name="CompactNextEpisodeButton" Style="{StaticResource CompactPlayerIconButtonStyle}" Click="OnNextEpisode"
                                            ToolTipService.ToolTip="下一集">
                                        <FontIcon Glyph="&#xE893;" FontSize="13"/>
                                    </Button>
                                </StackPanel>
                                <TextBlock x:Name="CompactTimeText" Grid.Column="1" Text="00:00 / 00:00"
                                           MinWidth="54" MaxWidth="132" Margin="4,0"
                                           FontSize="11" Foreground="#CCFFFFFF" VerticalAlignment="Center"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                                    <Button x:Name="CompactSpeedButton" Style="{StaticResource CompactPlayerMenuButtonStyle}"
                                            ToolTipService.ToolTip="倍速">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <TextBlock x:Name="CompactSpeedText" Text="1x"/>
                                            <FontIcon x:Name="CompactSpeedChevron" Glyph="&#xE70D;" FontSize="8"/>
                                        </StackPanel>
                                        <Button.Flyout>
                                            <MenuFlyout x:Name="CompactSpeedMenu" Opened="OnCompactSpeedMenuOpened" Closed="OnCompactSpeedMenuClosed">
                                                <RadioMenuFlyoutItem Text="1x" Tag="1" GroupName="compact-speed" IsChecked="True" Click="OnSpeedItem"/>
                                                <RadioMenuFlyoutItem Text="1.25x" Tag="1.25" GroupName="compact-speed" Click="OnSpeedItem"/>
                                                <RadioMenuFlyoutItem Text="1.5x" Tag="1.5" GroupName="compact-speed" Click="OnSpeedItem"/>
                                                <RadioMenuFlyoutItem Text="1.75x" Tag="1.75" GroupName="compact-speed" Click="OnSpeedItem"/>
                                                <RadioMenuFlyoutItem Text="2x" Tag="2" GroupName="compact-speed" Click="OnSpeedItem"/>
                                                <RadioMenuFlyoutItem Text="2.5x" Tag="2.5" GroupName="compact-speed" Click="OnSpeedItem"/>
                                                <RadioMenuFlyoutItem Text="3x" Tag="3" GroupName="compact-speed" Click="OnSpeedItem"/>
                                                <RadioMenuFlyoutItem Text="4x" Tag="4" GroupName="compact-speed" Click="OnSpeedItem"/>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>

                                    <Button x:Name="CompactScaleButton" Visibility="Collapsed"
                                            Style="{StaticResource CompactPlayerMenuButtonStyle}"
                                            ToolTipService.ToolTip="画面缩放">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <TextBlock x:Name="CompactScaleText" Text="原始"/>
                                            <FontIcon x:Name="CompactScaleChevron" Glyph="&#xE70D;" FontSize="8"/>
                                        </StackPanel>
                                        <Button.Flyout>
                                            <MenuFlyout x:Name="CompactScaleMenu" Opened="OnCompactScaleMenuOpened" Closed="OnCompactScaleMenuClosed">
                                                <RadioMenuFlyoutItem Text="原始" Tag="0" GroupName="compact-scale" IsChecked="True" Click="OnScaleItem"/>
                                                <RadioMenuFlyoutItem Text="拉伸" Tag="1" GroupName="compact-scale" Click="OnScaleItem"/>
                                                <RadioMenuFlyoutItem Text="16:9" Tag="2" GroupName="compact-scale" Click="OnScaleItem"/>
                                                <RadioMenuFlyoutItem Text="4:3" Tag="3" GroupName="compact-scale" Click="OnScaleItem"/>
                                                <RadioMenuFlyoutItem Text="填充" Tag="4" GroupName="compact-scale" Click="OnScaleItem"/>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>

                                    <Button x:Name="CompactFlagButton" Visibility="Collapsed"
                                            Style="{StaticResource CompactPlayerMenuButtonStyle}"
                                            ToolTipService.ToolTip="切换线路">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <TextBlock x:Name="CompactFlagText" Text="线路" MaxWidth="72" TextTrimming="CharacterEllipsis"/>
                                            <FontIcon x:Name="CompactFlagChevron" Glyph="&#xE70D;" FontSize="8"/>
                                        </StackPanel>
                                        <Button.Flyout>
                                            <MenuFlyout x:Name="CompactFlagMenu" Opened="OnCompactFlagMenuOpened" Closed="OnCompactFlagMenuClosed"/>
                                        </Button.Flyout>
                                    </Button>

                                    <Button x:Name="CompactEpisodeButton" Visibility="Collapsed"
                                            Style="{StaticResource CompactPlayerIconButtonStyle}"
                                            Click="OnOpenEpisodePane" ToolTipService.ToolTip="选集">
                                        <FontIcon Glyph="&#xE8FD;" FontSize="14"/>
                                    </Button>

                                    <Button x:Name="CompactDanmakuButton" Visibility="Collapsed"
                                            Style="{StaticResource CompactPlayerIconButtonStyle}"
                                            Click="OnDanmakuToggle" ToolTipService.ToolTip="关闭弹幕 (D)">
                                        <Grid Width="17" Height="17">
                                            <Grid x:Name="CompactDanmakuOnIcon">
                                                <Path Data="M2.25,3.25 L14.75,3.25 L14.75,11.75 L8.5,11.75 L5.25,14.75 L5.25,11.75 L2.25,11.75 Z"
                                                      Stroke="White" StrokeThickness="1.3" StrokeLineJoin="Round"/>
                                                <Path Data="M4.75,6.5 L12.5,6.5 M4.75,9 L10,9"
                                                      Stroke="White" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Grid>
                                            <Grid x:Name="CompactDanmakuOffIcon" Visibility="Collapsed">
                                                <Path Data="M2.25,3.25 L14.75,3.25 L14.75,11.75 L8.5,11.75 L5.25,14.75 L5.25,11.75 L2.25,11.75 Z"
                                                      Stroke="White" StrokeThickness="1.3" StrokeLineJoin="Round"/>
                                                <Path Data="M2.75,2.25 L14.5,14.75" Stroke="White" StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Grid>
                                        </Grid>
                                    </Button>

                                    <Button x:Name="CompactDanmakuMenuButton" Visibility="Collapsed"
                                            Style="{StaticResource CompactPlayerIconButtonStyle}"
                                            Click="OnOpenCompactDanmakuMenu" ToolTipService.ToolTip="弹幕源">
                                        <FontIcon Glyph="&#xE70F;" FontSize="13"/>
                                    </Button>

                                    <Button x:Name="CompactSubButton" Visibility="Collapsed"
                                            Style="{StaticResource CompactPlayerIconButtonStyle}"
                                            ToolTipService.ToolTip="字幕">
                                        <StackPanel Orientation="Horizontal" Spacing="1">
                                            <Grid Width="17" Height="17" IsHitTestVisible="False">
                                                <Path Data="M2,3.25 H15 A1,1 0 0 1 16,4.25 V12.75 A1,1 0 0 1 15,13.75 H2 A1,1 0 0 1 1,12.75 V4.25 A1,1 0 0 1 2,3.25 Z"
                                                      Stroke="White" StrokeThickness="1.3" StrokeLineJoin="Round"/>
                                                <Path Data="M7.25,6.25 H5.5 A1.25,1.25 0 0 0 4.25,7.5 V9.5 A1.25,1.25 0 0 0 5.5,10.75 H7.25 M12.75,6.25 H11 A1.25,1.25 0 0 0 9.75,7.5 V9.5 A1.25,1.25 0 0 0 11,10.75 H12.75"
                                                      Stroke="White" StrokeThickness="1.3" StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Grid>
                                            <FontIcon x:Name="CompactSubChevron" Glyph="&#xE70D;" FontSize="7"/>
                                        </StackPanel>
                                        <Button.Flyout>
                                            <MenuFlyout x:Name="CompactSubMenu" Opened="OnCompactSubMenuOpened" Closed="OnCompactSubMenuClosed">
                                                <MenuFlyoutItem Text="加载本地字幕…" Click="OnPickLocalSubtitle"/>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>

                                    <Button x:Name="CompactGearButton" Visibility="Collapsed"
                                            Style="{StaticResource CompactPlayerIconButtonStyle}"
                                            Click="OnOpenCompactGear" ToolTipService.ToolTip="播放设置">
                                        <FontIcon Glyph="&#xE713;" FontSize="14"/>
                                    </Button>

                                    <Button x:Name="CompactPipButton" Style="{StaticResource CompactPlayerIconButtonStyle}" Click="OnPip"
                                            ToolTipService.ToolTip="退出小窗模式"
                                            AutomationProperties.Name="退出小窗模式">
                                        <Grid Width="18" Height="18">
                                            <Path Data="M8,15.25 H2.75 A1.25,1.25 0 0 1 1.5,14 V4 A1.25,1.25 0 0 1 2.75,2.75 H15.25 A1.25,1.25 0 0 1 16.5,4 V8.5 M10,9.75 H15.25 A1.25,1.25 0 0 1 16.5,11 V14 A1.25,1.25 0 0 1 15.25,15.25 H10 A1.25,1.25 0 0 1 8.75,14 V11 A1.25,1.25 0 0 1 10,9.75 Z"
                                                  Stroke="White" StrokeThickness="1.3" StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Path Data="M8.5,9.5 L4.25,5.25 M4.25,8.25 V5.25 H7.25"
                                                  Stroke="White" StrokeThickness="1.3" StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource CompactPlayerIconButtonStyle}" Click="OnFullscreen"
                                            ToolTipService.ToolTip="全屏">
                                        <FontIcon x:Name="CompactFullIcon" Glyph="&#xE740;" FontSize="15"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 轻提示（自动关闭） -->
            <InfoBar x:Name="Toast" IsOpen="False" IsClosable="False" Severity="Informational"
                     VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,64,0,0"/>

            <!-- 播放错误（手动处理） -->
            <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="True" Severity="Error" Title="播放失败"
                     VerticalAlignment="Bottom" Margin="16,0,16,110"/>

            <!-- FFmpeg 缺失指引 -->
            <StackPanel x:Name="FfmpegPanel" Visibility="Collapsed" HorizontalAlignment="Center"
                        VerticalAlignment="Center" MaxWidth="480" Spacing="12"
                        Background="#CC1C1C1C" CornerRadius="8" Padding="24">
                <FontIcon Glyph="&#xE783;" FontSize="32" HorizontalAlignment="Center"/>
                <TextBlock Text="FFmpeg 未就绪" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="请将 FFmpeg 动态库（avcodec 等 dll）放入程序目录或数据目录的 ffmpeg 子目录后重启应用；详见「设置 → 关于」。"
                           TextWrapping="Wrap" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Button Content="返回" HorizontalAlignment="Center" Click="OnBack"/>
            </StackPanel>
        </Grid>
    </SplitView>
        </Border>
    </Grid>
</Page>
