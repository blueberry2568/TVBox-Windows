<Application
    x:Class="TVBoxForWindows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:TVBoxForWindows.UI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 尺寸常量 -->
            <x:Double x:Key="CardWidth">130</x:Double>
            <x:Double x:Key="PosterCardWidth">150</x:Double>
            <Thickness x:Key="PagePadding">24,16,24,0</Thickness>

            <!-- 通用转换器 -->
            <ui:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <ui:StringToVisibilityConverter x:Key="StringToVisibility"/>
            <ui:CountToVisibilityConverter x:Key="CountToVisibility"/>
            <ui:InverseBoolConverter x:Key="InverseBool"/>

            <!-- 文字样式：页面标题 28 SemiBold / 区块标题 18 SemiBold -->
            <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <!-- 卡片容器样式（设置页分组卡片等通用） -->
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
