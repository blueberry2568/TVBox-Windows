<Application
    x:Class="TVBoxForWindows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:TVBoxForWindows.UI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 尺寸常量 -->
            <x:Double x:Key="CardWidth">130</x:Double>
            <x:Double x:Key="PosterCardWidth">150</x:Double>
            <Thickness x:Key="PagePadding">24,16,24,0</Thickness>
            <CornerRadius x:Key="SurfaceCornerRadius">8</CornerRadius>
            <Thickness x:Key="PlayerSurfaceMargin">16</Thickness>
            <Thickness x:Key="LivePlayerSurfaceMargin">8,0,16,16</Thickness>
            <x:String x:Key="EpisodePickerGlyph">&#xE8FD;</x:String>

            <!-- 通用转换器 -->
            <ui:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <ui:StringToVisibilityConverter x:Key="StringToVisibility"/>
            <ui:CountToVisibilityConverter x:Key="CountToVisibility"/>
            <ui:InverseBoolConverter x:Key="InverseBool"/>

            <!-- 文字样式：页面标题 28 SemiBold / 区块标题 18 SemiBold -->
            <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <!-- 一级/二级页面统一返回入口。 -->
            <Style x:Key="PageBackButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="PageBackIconStyle" TargetType="FontIcon">
                <Setter Property="Glyph" Value="&#xE72B;"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="IsTextScaleFactorEnabled" Value="False"/>
            </Style>

            <!-- 卡片容器样式（设置页分组卡片等通用） -->
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="{StaticResource SurfaceCornerRadius}"/>
                <Setter Property="Padding" Value="16"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
