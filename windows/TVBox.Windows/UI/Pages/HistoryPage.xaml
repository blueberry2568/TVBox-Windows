<Page
    x:Class="TVBoxForWindows.UI.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TVBoxForWindows.UI.Controls"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <DataTemplate x:Key="HistoryTemplate">
            <StackPanel Margin="6"
                        Width="150"
                        PointerPressed="OnCardPointerPressed">
                <controls:PosterCard Pic="{Binding Pic}"
                                     Title="{Binding Title}"
                                     Remark="{Binding Remark}"/>
                <!-- 底部进度条（Position/Duration） -->
                <ProgressBar Maximum="100"
                             Value="{Binding Percent}"
                             Margin="2,6,2,0"/>
                <TextBlock Text="{Binding Meta}"
                           FontSize="11"
                           Margin="2,4,2,0"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="PageRoot" Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="历史" Style="{StaticResource PageTitleTextStyle}" VerticalAlignment="Center"/>
            <TextBlock x:Name="CountText"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Button x:Name="ClearButton" Visibility="Collapsed" Click="OnClearAll" ToolTipService.ToolTip="清空全部">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE75C;" FontSize="14"/>
                    <TextBlock Text="清空"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <GridView x:Name="HistoryGrid"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="OnItemClick"
                      ItemTemplate="{StaticResource HistoryTemplate}"
                      Padding="0,0,0,24"/>
            <TextBlock x:Name="EmptyText"
                       Text="暂无观看历史"
                       Visibility="Collapsed"
                       HorizontalAlignment="Center"
                       Margin="0,48,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>

        <Canvas x:Name="ContextLayer"
                Grid.RowSpan="2"
                Visibility="Collapsed"
                Background="Transparent"
                Canvas.ZIndex="1000"
                PointerPressed="OnContextLayerPointerPressed">
            <Border x:Name="ContextMenuPanel"
                    MinWidth="152"
                    Padding="4"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <Button HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnDeleteOne">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                            <TextBlock Text="删除该条"/>
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnClearAll">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE75C;" FontSize="16"/>
                            <TextBlock Text="清空全部"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Page>
