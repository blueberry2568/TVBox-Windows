<Page
    x:Class="TVBoxForWindows.UI.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TVBoxForWindows.UI.Controls"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <DataTemplate x:Key="CardTemplate">
            <controls:PosterCard Margin="6"
                                 Pic="{Binding Pic}"
                                 Title="{Binding Title}"
                                 Remark="{Binding Remark}"/>
        </DataTemplate>
        <DataTemplate x:Key="GroupedCardTemplate">
            <Button Background="Transparent" BorderThickness="0" Padding="0" Click="OnGroupedResultClick">
                <controls:PosterCard Margin="6"
                                     Pic="{Binding Pic}"
                                     Title="{Binding Title}"
                                     Remark="{Binding Remark}"/>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24,16,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Visibility="Collapsed" Width="40" Height="40" Padding="0"
                    Background="Transparent" BorderThickness="0" Click="OnBack"
                    ToolTipService.ToolTip="返回">
                <FontIcon Glyph="&#xE72B;" FontSize="16"/>
            </Button>
            <TextBlock Grid.Column="1" Text="搜索" FontSize="28" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
        </Grid>

        <!-- 搜索框 + 取消 + 站点范围提示 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
            <AutoSuggestBox x:Name="SearchBox"
                            Width="360"
                            QueryIcon="Find"
                            PlaceholderText="输入关键词搜索全部站点"
                            QuerySubmitted="OnQuerySubmitted"/>
            <Button x:Name="CancelButton" Content="取消" Visibility="Collapsed" Click="OnCancel"/>
            <TextBlock x:Name="ScopeText"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- 搜索历史 chips -->
        <Grid x:Name="HistoryPanel" Grid.Row="2" Margin="0,12,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer HorizontalScrollMode="Enabled"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ChipsPanel" Orientation="Horizontal" Spacing="8"/>
            </ScrollViewer>
            <Button Grid.Column="1" Content="清空" Margin="8,0,0,0" Click="OnClearHistory"/>
        </Grid>

        <!-- 搜索中进度 -->
        <ProgressBar x:Name="SearchProgress" Grid.Row="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,12,0,0"/>

        <!-- 站点横排：滚轮在此区域转换为横向滚动。 -->
        <ListView x:Name="SiteList"
                  Grid.Row="4"
                  Height="52"
                  Margin="0,8,0,0"
                  Visibility="Collapsed"
                  SelectionMode="Single"
                  SelectionChanged="OnSiteSelectionChanged"
                  PointerWheelChanged="OnSitePointerWheelChanged"
                  ScrollViewer.HorizontalScrollMode="Enabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollMode="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Header}" FontSize="14" Margin="5,4"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 当前站点结果只保留一个纵向滚动容器，避免与页面滚动争抢滚轮。 -->
        <Grid Grid.Row="5" Margin="0,8,0,0">
            <GridView x:Name="ResultGrid"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="OnResultClick"
                      ItemTemplate="{StaticResource CardTemplate}"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollMode="Enabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      Padding="0,0,0,24"/>
        </Grid>

        <!-- 分组纵览：外层只有一个纵向滚动容器，组内 ItemsRepeater 不接管滚轮。 -->
        <ListView x:Name="GroupedResultList"
                  Grid.Row="4"
                  Grid.RowSpan="2"
                  Margin="0,8,0,0"
                  HorizontalAlignment="Stretch"
                  Visibility="Collapsed"
                  SelectionMode="None"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollMode="Enabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,16"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Expander IsExpanded="True"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <TextBlock Text="{Binding Header}" FontSize="18" FontWeight="SemiBold" Margin="2,0"/>
                        </Expander.Header>
                        <ItemsRepeater ItemsSource="{Binding Items}" ItemTemplate="{StaticResource GroupedCardTemplate}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="162"
                                                   MinItemHeight="237"
                                                   MinRowSpacing="4"
                                                   MinColumnSpacing="4"
                                                   ItemsJustification="Start"
                                                   ItemsStretch="None"/>
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </Expander>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="EmptyText"
                   Grid.Row="5"
                   Canvas.ZIndex="2"
                   IsHitTestVisible="False"
                   Text="没有找到结果"
                   Margin="0,24,0,0"
                   HorizontalAlignment="Center"
                   Visibility="Collapsed"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Grid>
</Page>
